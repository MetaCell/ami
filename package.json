{
  "name": "@metacell/ami",
  "version": "0.34.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./build/ami.cjs",
  "module": "./build/ami.js",
  "types": "./build/ami.d.ts",
  "exports": {
    ".": {
      "types": "./build/ami.d.ts",
      "import": "./build/ami.js",
      "require": "./build/ami.cjs"
    }
  },
  "files": [
    "build"
  ],
  "keywords": [
    "ami",
    "ami.js",
    "three.js",
    "webgl",
    "dicom",
    "nifti",
    "medical",
    "imaging",
    "nrrd",
    "vtk",
    "stl",
    "trk"
  ],
  "author": {
    "name": "Nicolas Rannou",
    "email": "nicolas@eunate.ch",
    "url": "https://eunate.ch"
  },
  "contributors": [
    {
      "name": "MetaCell",
      "url": "https://metacell.us"
    }
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git@github.com:Metacell/ami.git"
  },
  "sideEffects": false,
  "peerDependencies": {
    "three": ">=0.180.0"
  },
  "dependencies": {
    "@cornerstonejs/codec-openjpeg": "^1.3.0",
    "dicom-parser": "1.8.21",
    "eventemitter3": "^5.0.4",
    "jpeg-lossless-decoder-js": "2.1.2",
    "math-float32-to-binary-string": "^1.0.0",
    "nifti-reader-js": "0.8.0",
    "nrrd-js": "^0.2.1",
    "pako": "2.1.0"
  },
  "devDependencies": {
    "@types/jasmine": "^6.0.0",
    "@types/node": "^25.6.0",
    "cross-env": "^10.1.0",
    "jsdoc": "^4.0.0",
    "jsdom": "^29.1.1",
    "rimraf": "^6.1.3",
    "shelljs": "^0.10.0",
    "sinon": "^21.1.2",
    "three": "^0.184.0",
    "typescript": "^6.0.3",
    "unplugin-dts": "^1.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "scripts": {
    "build": "vite build",
    "build:prod": "vite build --mode production",
    "clean": "rimraf build",
    "dev": "vite build --watch",
    "dev:examples": "vite --config vite.examples.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "doc": "jsdoc -p -r -R README.md -c jsdoc.json -d dist/doc src"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
